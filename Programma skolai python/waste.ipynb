import streamlit as st

# ==============================
# Laser Cutting Waste Calculator
# ==============================

st.set_page_config(page_title="Laser Waste Calculator", layout="centered")

st.title("🔦 Laser Cutting Waste Calculator")

st.write("Enter your sheet and used material values:")

# --- USER INPUT (GUI) ---
sheet_width = st.number_input("Sheet width (mm)", min_value=0.0, step=1.0)
sheet_height = st.number_input("Sheet height (mm)", min_value=0.0, step=1.0)
used_area = st.number_input("Used area (mm²)", min_value=0.0, step=100.0)

# --- BUTTON ---
if st.button("Calculate Waste"):

    sheet_area = sheet_width * sheet_height

    if sheet_area == 0:
        st.error("Sheet area cannot be zero.")
    elif used_area > sheet_area:
        st.error("Used area cannot be larger than sheet area.")
    else:
        waste_area = sheet_area - used_area
        waste_percentage = (waste_area / sheet_area) * 100

        st.success("Calculation complete ✅")

        # --- OUTPUT ---
        st.subheader("📊 Results")
        st.metric("Sheet Area (mm²)", f"{sheet_area:,.0f}")
        st.metric("Used Area (mm²)", f"{used_area:,.0f}")
        st.metric("Waste Area (mm²)", f"{waste_area:,.0f}")
        st.metric("Waste (%)", f"{waste_percentage:.2f} %")

        # --- VISUAL BAR ---
        st.subheader("Material Usage")
        st.progress(int(100 - waste_percentage))

